DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret
AGENT_HOST=0.0.0.0
AGENT_PORT=5000
# Maximum PostgreSQL connections reserved by one Agent replica for session fences.
AGENT_CHECKPOINT_LOCK_POOL_SIZE=16
# Set true only for local development with file watching.
AGENT_RELOAD=false
# Optional plain-text contacts for the deployment's verified local crisis resources.
# Leave blank when the deployment has not confirmed region-specific information.
CRISIS_RESOURCE_TEXT=

# Bounded Agent request and model-call budgets.
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=5
LLM_CONTEXT_SUMMARY_MAX_CONCURRENT_CALLS=1
AGENT_TURN_TIMEOUT_SECONDS=240
