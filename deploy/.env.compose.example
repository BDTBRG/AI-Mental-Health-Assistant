# Local demo credentials only. Replace these values before sharing this runtime.
# Use URL-safe characters for passwords consumed by Redis/PostgreSQL connection URLs.
MYSQL_ROOT_PASSWORD=local-demo-mysql-root-2026
MYSQL_USER=amha
MYSQL_PASSWORD=local-demo-mysql-user-2026
REDIS_PASSWORD=local-demo-redis-password-2026
POSTGRES_DB=langgraph
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=local-demo-postgres-password-2026

RUSTFS_ACCESS_KEY=amha-demo-access-key
RUSTFS_SECRET_KEY=local-demo-rustfs-secret-2026
FILE_UPLOAD_S3_BUCKET=amha-uploads

JWT_SECRET=local-demo-jwt-secret-replace-before-sharing-2026-10
AGENT_INTERNAL_TOKEN=local-demo-agent-token-replace-before-sharing-2026

# Optional. Chat generation will remain unavailable until an authorized key is supplied.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
